<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">

    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>app</directory>
        </include>
        <exclude>
            <directory>app/Http/Middleware</directory>
            <directory>app/Console</directory>
            <directory>app/Providers</directory>
            <file>app/Http/Kernel.php</file>
        </exclude>
    </source>

    <php>
        <env name="APP_ENV"              value="testing"/>
        <env name="DB_CONNECTION"        value="mysql"/>
        <env name="DB_HOST"              value="127.0.0.1"/>
        <env name="DB_PORT"              value="3306"/>
        <env name="DB_DATABASE"          value="4th_year_project_test"/>
        <env name="DB_USERNAME"          value="root"/>
        <env name="DB_PASSWORD"          value=""/>
        <env name="CACHE_DRIVER"         value="array"/>
        <env name="SESSION_DRIVER"       value="array"/>
        <env name="QUEUE_CONNECTION"     value="sync"/>
        <env name="BROADCAST_DRIVER"     value="null"/>
        <env name="MAIL_MAILER"          value="array"/>
        <env name="OTP_BYPASS_ENABLED"   value="true"/>
        <env name="WALLET_OTP_MODE"      value="testing"/>
        <env name="JWT_SECRET"           value="test_secret_key_for_testing_only_32chars"/>
        <env name="JWT_TTL"              value="600"/>
        <env name="PUSHER_APP_ID"        value=""/>
        <env name="FIREBASE_CREDENTIALS" value=""/>
    </php>

</phpunit>
